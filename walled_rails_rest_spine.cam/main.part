# walled_rails_rest_spine.cam — walled_rails_rest with its rest op pinned to
# `pattern=spine` (Phase 33 slice 4; DECISIONS.md → "Phase 33 slice 4…"): the
# rest floor is walked as any floor is, and `nacs --patterns` measures it.
# The rest of this header is walled_rails_rest's (Phase 33 slice 1;
# DECISIONS.md → "Phase 33 slice 1: the rest floor…"). Op 1 is walled_rails'
# own: a 10mm tool faces the land and concedes the three stretches it cannot
# enter (`cover=92.7`). Op 2 takes exactly those — `strategy=rest`, the word a
# Clear already has — with a 3mm tool: three small floors, each the stretch
# less what stands, walls against the fins and open against op 1's cut. Not
# the whole land again: that was 840–1358s, 95–97% of it in air.
units mm
feed 800
plunge 300
rapid_z 5
clearance_z 25
spindle 3000

stock Box(w=190, l=140, h=20, x=-5, y=-5, z=0)

tool T5 Endmill(dia=10.0)
tool T6 Endmill(dia=3.0)

run End(tool=T5, surface=Land, stepover=5.0, cover=92.7, pattern=offset)
run End(tool=T6, surface=Land, stepover=1.5, strategy=rest, pattern=spine)
