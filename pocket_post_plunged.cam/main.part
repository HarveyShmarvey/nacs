# pocket_post_plunged.cam/main.part — pocket_post_spine.cam with every descent a plunge
# (ROADMAP item 2, slice 4): the first stroke, which the plan would ramp down in legs, is
# entered by a plunge into standing stock, said so; the rest plunge beside cut floor as before.
units mm
feed 800
plunge 300
rapid_z 5
clearance_z 25
spindle 3000

stock Box(w=100, l=100, h=20, x=0, y=0, z=0)

tool T5 Endmill(dia=10.0)

feature PocketProfile ProfilePocket(extent=5.0
    20 20
    80 20
    80 80
    20 80
)

# The one added line: a post standing from the pocket floor (z=-5) to the
# top face, dead centre in the footprint the Clear below sweeps.
feature Post CylinderBoss(dia=12, extent=5, x=50, y=50, z=-5)

run Clear(tool=T5, profile=PocketProfile, stepover=4.0, pattern=spine, entry=plunge)
