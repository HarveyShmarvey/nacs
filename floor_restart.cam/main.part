# floor_restart.cam — the restart ladder, hand-placed (DECISIONS.md
# "N-words…", fork 1A). Three rungs, three first-line classes: N10 lands on
# the first block's M06 (the op's own state establishment), N15 on a title
# (the op changes nothing upstream of its moves), N30 on the leaving M09 of
# a tool change — the retract-and-re-establish sequence, which is exactly
# the safest line to cycle-start from. The third op is deliberately
# unnumbered: the ladder is sparse and meaningful, the wish's own words —
# an operator hunting a resume point wants rungs, not forty thousand
# sequential N-words. Order and spacing are the author's; only a duplicate
# rung rejects.
units mm
feed 800
plunge 300
rapid_z 5
clearance_z 25
spindle 3000

stock Box(w=60, l=60, h=20, x=0, y=0, z=0)

tool T1 Endmill(dia=10.0)
tool T2 Endmill(dia=6.0)

feature Top Plane(z=-0.5)
feature Mid Plane(z=-1.0)
feature Low Plane(z=-1.5)
feature Fin Plane(z=-2.0)

run End(tool=T1, surface=Top, stepover=6.0, n=10)
run End(tool=T1, surface=Mid, stepover=6.0, n=15)
run End(tool=T1, surface=Low, stepover=6.0, spindle=2400)
run End(tool=T2, surface=Fin, stepover=4.0, n=30)
