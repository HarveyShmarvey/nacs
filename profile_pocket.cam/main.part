# profile_pocket.cam — engine-comp finishing fixture. No `comp=` on the run, so it uses
# the default engine mode: the engine offsets the profile by the tool radius and
# emits plain coordinates (no G41/G42). A convex profile keeps the offset
# arc-free (sharp corners), which is all this version of engine mode emits.
# The loop is wound CCW, so the tool cuts *inside* it (the winding convention,
# DECISIONS.md "Row-2.4 `side` selector") — this is a window's inside wall,
# hence the feature name. The CW/outside case is pinned by boss.cam.
units mm
feed 800
plunge 300
rapid_z 5
clearance_z 25
spindle 3000

stock Box(w=100, l=100, h=20, x=0, y=0, z=0)

tool T5 Endmill(dia=10.0)

feature Window ProfilePocket(extent=2.0
    20 20
    80 20
    80 80
    20 80
)

run Side(tool=T5, surface=Window)
