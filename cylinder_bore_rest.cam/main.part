# cylinder_bore_rest.cam — the adaptive-clearing slice-1 demo pair
# (DECISIONS.md "adaptive clearing — the field picks the passes…"): the bore
# whose wall is finished but whose core no op cleared — exactly the part the
# rest-material report sizes (~10^4 mm³ forgotten) — followed by the op that
# report was pointing at: Clear(strategy=rest) selects its concentric-circle
# family against the stock as it stands BEFORE it, and clears the standing
# core. The report on THIS program reports none.
#
# The field's resolution is program text (voxel_cell is explicit-only — a
# derived default that moved would silently change which loops drop).
units mm
feed 800
plunge 300
rapid_z 5
clearance_z 25
spindle 3000

stock Box(w=100, l=100, h=20, x=0, y=0, z=0)

tool T5 Endmill(dia=10.0)

feature Bore CylinderBore(dia=60.0, extent=12.0, x=50.0, y=50.0)

run Side(tool=T5, surface=Bore, stepover=5.0)
run Clear(tool=T5, profile=Bore, stepover=4.0, strategy=rest, voxel_cell=1.0)
