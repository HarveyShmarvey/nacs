# Proposed features recognized from pocket_post.step by sidecar/import_step.py
# (contract v1 -- see sidecar/CONTRACT.md). Review before use:
# recognition proposes, it does not machine.

# F1: outer profile under top cap F3: vertical wall loop F1 F2 F6 F4, top at z=20.0, base at z=0.0, material inside the loop (CHECKLIST row 2.2)
# consume with: run Side(tool=..., surface=F1_Profile, comp=control)  [the feature carries its own z + extent]
# the loop is wound CW: material inside, tool outside (the winding convention,
# DECISIONS.md -> "Row-2.4 side selector")
# comp=control is required on Contour runs: recognized boundaries carry rounded
# corners tessellated to chords, and engine comp hard-errors on rounded-corner
# offsets (DECISIONS.md -> "recognized contours propose comp=control")
feature F1_Profile ProfileBoss(z=20.0, extent=20.0
    0.0 0.0
    0.0 100.0
    100.0 100.0
    100.0 0.0
)

# F3: planar, normal +Z, topmost planar face (CHECKLIST row 1.1)
feature F3_Top Plane(z=20.0)

# F11: pocket floor at z=15.0; vertical wall loop F7 F8 F9 F10, mouth at z=20.0, depth 5.0, opens upward; 2 inner wires -- standing material inside the pocket proposes beside it (CHECKLIST row 2.1)
# consume with: run Clear(tool=..., profile=F11_Pocket, stepover=...)  [the feature carries its own z + extent]
# or finish with: run Side(tool=..., surface=F11_Pocket, comp=control)
# comp=control is required on recognized profile Side runs: recognized boundaries carry rounded
# corners tessellated to chords, and engine comp hard-errors on rounded-corner
# offsets (DECISIONS.md -> "recognized contours propose comp=control")
# this floor has 2 inner wires: a boss proposed INSIDE this loop is its island, derived from
# containment -- the Clear above goes around it (stepover at most the tool's radius), and the
# island takes no Clear of its own. CHECK that every inner wire has a proposed boss below:
# standing material this reader could not name is NOT in the proposal, and would be cleared through.
feature F11_Pocket ProfilePocket(z=20.0, extent=5.0
    20.0 20.0
    80.0 20.0
    80.0 80.0
    20.0 80.0
)

# F12: cylindrical, axis +Z, full revolution, material inside (a standing boss), flat top cap F17, clean base at z=15.0 (CHECKLIST row 2.4)
# finish the wall with: run Side(tool=..., surface=F12_Boss, stepover=...)  [stepover is the ring spacing up the wall]
# the tool rides outside at R + r_tool (convex flank; finish_cylinder's mirror)
feature F12_Boss CylinderBoss(dia=12.0, extent=5.0, x=38.0, y=40.0, z=15.0)

# F13: outer profile under top cap F18: vertical wall loop F13 F14 F15 F16, top at z=20.0, base at z=15.0, material inside the loop (CHECKLIST row 2.2)
# consume with: run Side(tool=..., surface=F13_Profile, comp=control)  [the feature carries its own z + extent]
# the loop is wound CW: material inside, tool outside (the winding convention,
# DECISIONS.md -> "Row-2.4 side selector")
# comp=control is required on Contour runs: recognized boundaries carry rounded
# corners tessellated to chords, and engine comp hard-errors on rounded-corner
# offsets (DECISIONS.md -> "recognized contours propose comp=control")
feature F13_Profile ProfileBoss(z=20.0, extent=5.0
    44.0 60.0
    44.0 70.0
    58.0 70.0
    58.0 60.0
)

# F17: planar, normal +Z, topmost planar face (CHECKLIST row 1.1)
feature F17_Top Plane(z=20.0)

# F18: planar, normal +Z, topmost planar face (CHECKLIST row 1.1)
feature F18_Top Plane(z=20.0)
