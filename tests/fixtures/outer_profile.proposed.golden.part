# F6: outer profile under top cap F5: vertical wall loop F6 F8 F9 F7, top at z=10.0, base at z=0.0, material inside the loop (CHECKLIST row 2.2)
# consume with: run Side(tool=..., surface=F6_Profile, comp=control)  [the feature carries its own z + extent]
# the loop is wound CW: material inside, tool outside (the winding convention,
# DECISIONS.md -> "Row-2.4 side selector")
# comp=control is required on Contour runs: recognized boundaries carry rounded
# corners tessellated to chords, and engine comp hard-errors on rounded-corner
# offsets (DECISIONS.md -> "recognized contours propose comp=control")
feature F6_Profile ProfileBoss(z=16.0, extent=16.0
    0.0 0.0
    0.0 50.0
    60.0 50.0
    60.0 0.0
)

# F10: cylindrical, axis +Z, full revolution, material inside (a standing boss), flat top cap F21, clean base at z=10.0 (CHECKLIST row 2.4)
# finish the wall with: run Side(tool=..., surface=F10_Boss, stepover=...)  [stepover is the ring spacing up the wall]
# the tool rides outside at R + r_tool (convex flank; finish_cylinder's mirror)
feature F10_Boss CylinderBoss(dia=16.0, extent=6.0, x=14.0, y=14.0, z=10.0)

