# F5: planar, normal +Z, topmost planar face (CHECKLIST row 1.1)
feature F5_Top Plane(z=30.0)

# F7: cylindrical, axis +Z, full revolution, material outside (a bore), opens upward; flat floor F12 -- a milled bore (CHECKLIST row 2.3)
# finish the wall with: run Side(tool=..., surface=F7_Bore, stepover=...)  [stepover is the ring spacing up the wall]
# a flat floor is milled, not drilled -- a twist drill leaves a conical point, so no drill run is suggested
feature F7_Bore CylinderBore(dia=12.0, extent=18.0, x=20.0, y=-35.0)

# F8: outer profile under top cap F13: vertical wall loop F8 F10 F11 F9, top at z=28.0, base at z=20.0, material inside the loop (CHECKLIST row 2.2)
# consume with: run Side(tool=..., surface=F8_Profile, comp=control)  [the feature carries its own z + extent]
# the loop is wound CW: material inside, tool outside (the winding convention,
# DECISIONS.md -> "Row-2.4 side selector")
# comp=control is required on Contour runs: recognized boundaries carry rounded
# corners tessellated to chords, and engine comp hard-errors on rounded-corner
# offsets (DECISIONS.md -> "recognized contours propose comp=control")
feature F8_Profile ProfileBoss(z=30.0, extent=10.0
    35.0 -10.0
    35.0 10.0
    55.0 10.0
    55.0 -10.0
)

# F13: planar, normal +Z, below the topmost height: a bounded face at z=28.0, 1 loop (outer); caps recognized outer profile F8_Profile (CHECKLIST row 1.1)
feature F13_Face Face(z=28.0
    loop
        35.0 -10.0
        55.0 -10.0
        55.0 10.0
        35.0 10.0
)
