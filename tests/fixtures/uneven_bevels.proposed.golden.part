# Proposed features recognized from uneven_bevels.step by sidecar/import_step.py
# (contract v1 -- see sidecar/CONTRACT.md). Review before use:
# recognition proposes, it does not machine.

# F1: outer profile under top cap F3: vertical wall loop F1 F2 F6 F4, top at z=20.0, base at z=0.0, material inside the loop (CHECKLIST row 2.2)
# consume with: run Side(tool=..., surface=F1_Profile, comp=control)  [the feature carries its own z + extent]
# the loop is wound CW: material inside, tool outside (the winding convention,
# DECISIONS.md -> "Row-2.4 side selector")
# comp=control is required on Contour runs: recognized boundaries carry rounded
# corners tessellated to chords, and engine comp hard-errors on rounded-corner
# offsets (DECISIONS.md -> "recognized contours propose comp=control")
feature F1_Profile ProfileBoss(z=28.0, extent=28.0
    0.0 0.0
    0.0 80.0
    100.0 80.0
    100.0 0.0
)

# F3: planar, normal +Z, below the topmost height: a bounded face at z=20.0, 2 loops (outer + 1 inner); caps recognized outer profile F1_Profile (CHECKLIST row 1.1)
feature F3_Face Face(z=20.0
    loop
        0.0 0.0
        100.0 0.0
        100.0 80.0
        0.0 80.0
    loop
        10.0 10.0
        10.0 30.0
        40.0 30.0
        40.0 10.0
)

# F7: outer profile under top cap F15: vertical wall loop F8 F10 F9 F7, top at z=28.0, base at z=20.0, material inside the loop; top edge beveled at 90.0deg included with legs that differ edge to edge (F13 F12 F14 F11: 1.0, 1.5) -- the loop carries 1.0 as its chamfer_depth and its points restate the leg where it changes (CHECKLIST row 2.2)
# consume with: run Side(tool=..., surface=F7_Profile, comp=control)  [the feature carries its own z + extent]
# the loop is wound CW: material inside, tool outside (the winding convention,
# DECISIONS.md -> "Row-2.4 side selector")
# comp=control is required on Contour runs: recognized boundaries carry rounded
# corners tessellated to chords, and engine comp hard-errors on rounded-corner
# offsets (DECISIONS.md -> "recognized contours propose comp=control")
# the top edge's bevel is 1.0mm deep on most edges, at the included angle the model
# measures, and the loop's points restate the leg where it changes (0 leaves an edge unbroken) --
# break it with: run Form(tool=<ChamferMill>, surface=F7_Profile)  [engine comp: control comp cannot
# lift off an unbroken edge, and the deeper leg reaches about a reach's width round each corner]
feature F7_Profile ProfileBoss(z=28.0, extent=8.0, chamfer_depth=1.0, chamfer_angle=90.0
    10.0 10.0 chamfer_depth=1.5
    10.0 30.0 chamfer_depth=1.0
    40.0 30.0 chamfer_depth=1.5
    40.0 10.0 chamfer_depth=1.0
)

# F15: planar, normal +Z, topmost planar face (CHECKLIST row 1.1)
feature F15_Top Plane(z=28.0)
