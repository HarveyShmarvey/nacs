# bore_regions.cam — the regions bore arm (DECISIONS.md "adaptive clearing,
# region decomposition…", the named machinery-sharing follow-up): two declared
# bores overlap, the dia-10 tool clears the first dense, and what stands in
# the second is a LUNE — off-center material no concentric family can aim at
# without cutting air it already accounted for. The dia-3 regions op lets the
# field shape the lune's own spiral while the circle declaration keeps the
# wall; the cusp slivers where the lune pinches thinner than the tool are the
# residue law's subject, stated in the emitted text and standing in the report
# at their own band.
units mm
feed 800
plunge 300
rapid_z 5
clearance_z 25
spindle 3000

stock Box(w=60, l=60, h=15, x=0, y=0, z=0)

tool T5 Endmill(dia=10.0)
tool T3 Endmill(dia=3.0)

feature BoreA CylinderBore(dia=20.0, extent=6.0, x=24.0, y=30.0)
feature BoreB CylinderBore(dia=14.0, extent=6.0, x=38.0, y=30.0)

run Clear(tool=T5, profile=BoreA, stepover=4.0)
run Clear(tool=T3, profile=BoreB, stepover=1.0, strategy=regions, voxel_cell=0.25)
