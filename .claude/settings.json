{
  "permissions": {
    "allow": [
      "Bash(cargo *)",
      "Bash(CARGO_TARGET_DIR=target/agent cargo *)",
      "Bash(./lock.sh)",
      "Bash(./check.sh)",
      "Bash(./shots.sh *)",
      "Bash(sh setup.sh)",
      "Bash(sidecar/.venv/Scripts/python.exe *)",
      "Bash(sidecar/.venv/bin/python *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(git stash *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git update-index *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh run rerun *)",
      "PowerShell(cargo *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * main)",
      "Bash(git push * main:*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "PowerShell(gh pr merge *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          { "type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/session-start.sh", "timeout": 1800 }
        ]
      }
    ]
  }
}
