run End(tool=T2, surface=Skim, stepover=8.0, pattern=raster)
run End(tool=T2, surface=Deck, stepover=6.0, pattern=offset)
run Side(tool=T2, surface=Post, stepover=5.0)
run Side(tool=T2, surface=Lobe)
