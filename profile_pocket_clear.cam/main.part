# profile_pocket_clear.cam — area clearance of the ProfilePocket void
# (CHECKLIST row 2.1): the Clear op's spiral, innermost-out, wall pass last at
# exactly r off the boundary. The wall-finishing sibling on the same loop is
# profile_pocket.cam; the roughing variant is profile_pocket_clear_rough.cam.
units mm
feed 800
plunge 300
rapid_z 5
clearance_z 25
spindle 3000

stock Box(w=100, l=100, h=20, x=0, y=0, z=0)

tool T5 Endmill(dia=10.0)

# `extent` is the feature's own vertical occupancy: the wall lives in
# [z - extent, z], and `z` defaults to the stock top. The op says which tool
# cuts it and how, never how far down (DECISIONS.md "Vertical occupancy is
# `extent`…").
feature PocketProfile ProfilePocket(extent=5.0
    20 20
    80 20
    80 80
    20 80
)

run Clear(tool=T5, profile=PocketProfile, stepover=4.0)
