# floor_dry.cam — the first program that can say "no coolant" (DECISIONS.md
# "coolant as a modeled setting…", slice 0). T1 declares coolant=off — a dry
# cutter, graphite-mill style — so the tool-change block carries NO M08: the
# always-flood assumption is now a declared default a program can decline.
# The second Floor overrides per-op (coolant=flood, the odd wet pass), so
# the op boundary shows the transition shape: M09 then M08, off-then-on, on
# the bare-S re-issue's precedent — and the program ends with the
# unconditional M09 exactly as every program always has.
units mm
feed 800
plunge 300
rapid_z 5
clearance_z 25
spindle 3000

stock Box(w=60, l=60, h=20, x=0, y=0, z=0)

tool T1 Endmill(dia=10.0, coolant=off)

feature Top Plane(z=-0.5)
feature Deeper Plane(z=-1.0)

run End(tool=T1, surface=Top, stepover=6.0)
run End(tool=T1, surface=Deeper, stepover=6.0, coolant=flood)
