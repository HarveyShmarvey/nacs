# curved_rails_spine.cam — curved_rails_offset.cam with `pattern=spine` on both faces
# (Phase 31; DECISIONS.md → the "Phase 31…" entries).
units mm
feed 800
plunge 300
rapid_z 5
clearance_z 25
spindle 3000

stock Box(w=170, l=130, h=21, x=-5, y=-5, z=1)

tool T5 Endmill(dia=10.0)

run End(tool=T5, surface=Land, stepover=5.0, pattern=spine)
run End(tool=T5, surface=SpiralBoss, stepover=5.0, pattern=spine)
