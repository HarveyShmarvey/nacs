# deck_rest_offset.cam — the rest floor on a PLANE (Phase 33 slice 5; DECISIONS.md →
# "Phase 33 slice 5: the plane concedes…"). Two posts stand through a faced
# deck 6mm apart. The 12mm tool faces round them and cannot enter the web
# between them; since this slice a Plane concedes it like a Face or a pocket
# (`cover=99`) instead of refusing by the older web law, and names the op
# that takes it. The 4mm tool takes the web and nothing else.
units mm
feed 800
plunge 300
rapid_z 5
clearance_z 25
spindle 3000
stock Box(w=100, l=60, h=20, x=0, y=0, z=0)
tool T2 Endmill(dia=12.0)
tool T3 Endmill(dia=4.0)
feature Deck Plane(z=-5)
feature PostA CylinderBoss(dia=20, extent=5, x=35, y=30, z=-5)
feature PostB CylinderBoss(dia=20, extent=5, x=61, y=30, z=-5)
run End(tool=T2, surface=Deck, stepover=5.0, cover=99, pattern=offset)
run End(tool=T3, surface=Deck, stepover=2.0, strategy=rest, pattern=offset)
